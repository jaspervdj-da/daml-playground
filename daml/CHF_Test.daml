module CHF_Test where

import Daml.Script

import CHF

-- total_chf : Party -> Decimal
total_chf p = do
    chfs <- query p
    pure $ sum [chf.amount | (_, chf : CHF) <- chfs]

assertTotalCHF p expected = do
    actual <- total_chf p
    assertMsg
        ("Expected party to have CHF" <> show expected <>
            " but got CHF" <> show actual) $
        actual == expected

simple_test = do
    alice <- allocateParty "alice"
    bob <- allocateParty "bob"

    aliceCHF <- submit alice do
      createCmd CHF with
        amount = 10000.0
        owner = alice
        observers = []

    bobAccept <- submit bob do
      createCmd CHFAccept with
        owner = bob
        from = alice

    -- Can't transfer more than than what is in the account.
    submitMustFail alice do
      exerciseCmd bobAccept CHFAccept_Transfer with
        chf = aliceCHF
        amount = 10001.0

    (bobCHF, Some newAliceCHF) <- submit alice do
      exerciseCmd bobAccept CHFAccept_Transfer with
        chf = aliceCHF
        amount = 2000.0

    assertTotalCHF alice 8000.0
    assertTotalCHF bob 2000.0

    -- Can't transfer the same CHF twice.
    submitMustFail alice do
      exerciseCmd bobAccept CHFAccept_Transfer with
        chf = aliceCHF
        amount = 2000.0

    -- Transfer exactly the remaining funds.
    (_, None) <- submit alice do
      exerciseCmd bobAccept CHFAccept_Transfer with
        chf = newAliceCHF
        amount = 8000.0

    assertTotalCHF alice 0.0
    assertTotalCHF bob 10000.0
